# Copy to `.env` in the repo root (never commit `.env`).
# npm install / npm run env:sync generates `src/environments/secrets.generated.ts`.

# --- Google Gemini (booking helper) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Firebase (web app config from Firebase Console → Project settings → Your apps) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=timothylayden-note.firebaseapp.com
FIREBASE_PROJECT_ID=timothylayden-note
FIREBASE_STORAGE_BUCKET=timothylayden-note.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
